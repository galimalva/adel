---
import Layout from "../layouts/Layout.astro";
---

<Layout title="ارتباط | عادل سادات" description="راه‌های ارتباط با عادل سادات" activePage="contact">

  <section class="contact-page">
    <div class="contact-inner">
      <span class="contact-label">03 / ارتباط</span>
      <h1>برای ارتباط <br /><em>با من</em></h1>
      <p class="contact-description">برای همکاری، گفتگو، پروژه‌های ادبی یا ارتباط حرفه‌ای می‌توانید از راه‌های زیر با من در تماس باشید.</p>
      <a href="mailto:writer@example.com" class="email-link">writer@example.com <span>↗</span></a>
      <div class="contact-socials">
        <a href="#">Instagram</a>
        <a href="#">Telegram</a>
        <a href="#">LinkedIn</a>
      </div>
      <div class="back-home">
        <span>پایان</span>
        <a href="/">بازگشت به صفحه اصلی <strong>←</strong></a>
      </div>
    </div>
  </section>

  <footer>
    <div>
      <strong>عادل سادات</strong>
      <span>وب‌سایت شخصی</span>
    </div>
    <p>© 2026 تمامی حقوق محفوظ است.</p>
  </footer>

</Layout>

<style>
.contact-page { min-height: calc(100vh - 130px); padding: 170px 5vw 100px; }
.contact-inner { max-width: var(--max-width); margin: auto; }
.contact-label { color: var(--bg); font-size: .78rem; }
.contact-page h1 { margin-top: 20px; font-size: clamp(3rem, 8vw, 7.3rem); line-height: 1.12; font-weight: 300; word-spacing: normal; }
.contact-page h1 em { color: var(--text); font-family: serif; font-weight: 400; }
.contact-description { margin-top: 35px; max-width: 580px; color: var(--text-soft); font-size: 1rem; }
.email-link { margin-top: 45px; display: inline-flex; align-items: center; gap: 25px; font-size: clamp(1.35rem, 3vw, 2.6rem); border-bottom: 1px solid var(--text-soft); padding-bottom: 5px; transition: .3s; }
.email-link:hover { color: var(--text); gap: 35px; border-color: var(--text); }
.contact-socials { margin-top: 60px; display: flex; align-items: center; gap: 35px; flex-wrap: wrap; font-size: .85rem; }
.contact-socials a { position: relative; padding-bottom: 3px; }
.contact-socials a::after { content: ""; position: absolute; right: 0; bottom: 0; width: 0; height: 1px; background: var(--text); transition: .3s; }
.contact-socials a:hover::after { width: 100%; }
.back-home { margin-top: 100px; padding-top: 30px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; }
.back-home > span { color: var(--text-soft); font-size: .75rem; opacity: .5; }
.back-home a { display: flex; align-items: center; gap: 20px; transition: .3s; }
.back-home a strong { color: var(--bg); font-size: 1.5rem; }
.back-home a:hover { gap: 28px; color: var(--bg); }
footer { max-width: var(--max-width); min-height: 130px; margin: auto; padding: 30px 5vw; display: flex; justify-content: space-between; align-items: center; color: var(--text-soft); font-size: .75rem; opacity: .5; }
footer div { display: flex; flex-direction: column; }
footer strong { color: var(--text); font-size: .9rem; }

@media (max-width: 900px) {
  .contact-page { padding: 130px 6vw 80px; }
  .contact-page h1 { font-size: clamp(3rem, 13vw, 5rem); }
  .back-home { margin-top: 70px; }
  footer { flex-direction: column; align-items: flex-start; gap: 20px; padding-top: 35px; padding-bottom: 35px; }
}
@media (max-width: 520px) {
  .contact-page h1 { font-size: 3rem; }
  .email-link { font-size: 1.15rem; gap: 12px; word-break: break-all; }
  .contact-socials { gap: 22px; }
  .back-home { flex-direction: column; align-items: flex-start; gap: 15px; }
}
</style>