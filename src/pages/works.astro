---
import Layout from "../layouts/Layout.astro";

const books = [
  { title: "نام کتاب اول", year: "۱۴۰۵", description: "توضیح کوتاهی درباره کتاب و موضوع اصلی آن در دو یا سه خط.", image: "/book-1.jpg", link: "#", button: "خرید کتاب" },
  { title: "نام کتاب دوم", year: "۱۴۰۴", description: "معرفی کوتاه کتاب دوم و توضیحی مختصر درباره محتوای آن.", image: "/book-2.jpg", link: "#", button: "دانلود کتاب" },
  { title: "نام کتاب سوم", year: "۱۴۰۳", description: "چند جمله کوتاه درباره این اثر و فضای کلی کتاب.", image: "/book-3.jpg", link: "#", button: "مشاهده کتاب" },
];
---

<Layout title="آثار | عادل سادات" description="کتاب‌ها، نوشته‌ها و آثار عادل سادات" activePage="works">

  <section class="works-page">
    <div class="works-header">
      <div class="section-heading">
        <span>02 / آثار</span>
        <h1>کتاب‌ها و <em>نوشته‌ها</em></h1>
      </div>
      <p>بخشی از آثار منتشرشده یا منتخب عادل سادات.</p>
    </div>
    <div class="books-grid">
      {books.map((book, index) => (
        <article class="book-card">
          <div class="book-image">
            <span class="book-number">{String(index + 1).padStart(2, "0")}</span>
            <img src={book.image} alt={book.title} />
          </div>
          <div class="book-info">
            <div class="book-meta">
              <span>کتاب</span>
              <span>{book.year}</span>
            </div>
            <h2>{book.title}</h2>
            <p>{book.description}</p>
            <a href={book.link}>{book.button} <span>←</span></a>
          </div>
        </article>
      ))}
    </div>
    <div class="next-section">
      <span>مرحله بعد</span>
      <a href="/contact">ارتباط با من <strong>←</strong></a>
    </div>
  </section>

</Layout>

<style>
.works-page { max-width: var(--max-width); min-height: 100vh; margin: auto; padding: 170px 5vw 100px; }
.works-header { display: flex; justify-content: space-between; align-items: end; gap: 40px; }
.section-heading span { color: var(--bg); font-size: .78rem; }
.section-heading h1 { margin-top: 15px; font-size: clamp(2.8rem, 6vw, 5.8rem); line-height: 1.35; font-weight: 300; word-spacing: normal; }
.section-heading em { font-family: serif; color: var(--text); font-weight: 400; }
.works-header > p { max-width: 330px; color: var(--text-soft); font-size: .9rem; }
.books-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 35px; margin-top: 80px; }
.book-card { position: relative; }
.book-image { height: 440px; overflow: hidden; position: relative; background: var(--bg-soft); border: 1px solid var(--line); }
.book-image img { width: 100%; height: 100%; object-fit: cover; transition: .5s; }
.book-card:hover .book-image img { transform: scale(1.035); }
.book-number { position: absolute; top: 15px; left: 18px; z-index: 3; font-size: .72rem; background: var(--bg); padding: 5px 10px; border: 1px solid var(--line); color: var(--text); }
.book-info { padding: 24px 4px; }
.book-meta { display: flex; justify-content: space-between; color: var(--bg); font-size: .7rem; }
.book-info h2 { margin-top: 12px; font-size: 1.5rem; }
.book-info p { margin-top: 12px; color: var(--text-soft); font-size: .88rem; }
.book-info a { display: inline-flex; align-items: center; gap: 15px; margin-top: 22px; border-bottom: 1px solid var(--text); padding-bottom: 5px; font-size: .83rem; transition: .25s; }
.book-info a:hover { color: var(--bg); gap: 22px; }
.next-section { margin-top: 80px; display: flex; justify-content: space-between; align-items: center; padding-top: 30px; border-top: 1px solid var(--line); }
.next-section > span { color: var(--text-soft); font-size: .75rem; opacity: .5; }
.next-section a { display: flex; align-items: center; gap: 20px; font-size: 1rem; transition: .3s; }
.next-section a strong { color: var(--bg); font-size: 1.5rem; }
.next-section a:hover { gap: 28px; color: var(--bg); }

@media (max-width: 1000px) { .books-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 900px) {
  .works-page { padding: 130px 6vw 80px; }
  .works-header { align-items: flex-start; flex-direction: column; gap: 20px; }
  .books-grid { margin-top: 55px; }
}
@media (max-width: 650px) {
  .section-heading h1 { font-size: 2.7rem; }
  .books-grid { grid-template-columns: 1fr; gap: 55px; }
  .book-image { height: 470px; }
  .next-section { align-items: flex-start; flex-direction: column; gap: 15px; }
}
@media (max-width: 450px) { .book-image { height: 410px; } }
</style>